{
  "$schema": "https://example.com/eagar/schemas/eagar-rules-1.0.schema.json",
  "format": "eagar-rules",
  "formatVersion": "1.0",
  "documentId": "d1d2d3d4-aaaa-4bbb-8ccc-dddddddddddd",
  "revision": 7,
  "updatedAt": "2026-10-25T09:00:00Z",
  "author": {
    "app": "Eagar",
    "appVersion": "0.4.0",
    "platform": "macOS"
  },
  "dataClass": "college",
  "lanes": [],
  "rules": [],
  "guards": {},
  "playbooks": [
    {
      "id": "draft-playbook",
      "version": 1,
      "name": "Equipment availability reply",
      "category": "equipment-booking-answer",
      "laneIds": [
        "ncad"
      ],
      "trigger": {
        "description": "Student or staff asks whether a kit item is free on a date",
        "rule": {
          "field": "subject",
          "op": "matchesRegex",
          "value": "(?i)(book|borrow|available).*(camera|kit|tripod)"
        }
      },
      "requiredFacts": [
        {
          "name": "itemModel",
          "source": "thread"
        },
        {
          "name": "slots",
          "source": "cdbooking.availability"
        }
      ],
      "decisionInputs": [
        {
          "name": "slot",
          "prompt": "Which slot?",
          "options": [
            "morning",
            "afternoon"
          ]
        }
      ],
      "template": {
        "subject": "Re: booking",
        "body": "{{decision.slot}} works.",
        "branches": {
          "morning": "See you at 10.",
          "afternoon": "See you at 2."
        }
      },
      "guards": [
        "externalDomain",
        "missingAttachment"
      ],
      "approvedAt": null
    }
  ],
  "autonomy": [],
  "policy": null
}
